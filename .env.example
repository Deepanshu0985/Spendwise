# Copy to .env and fill in real values. Never commit the real .env (see .gitignore).
# Full variable reference: docs/08-devops/environments.md
#
# Gotcha worth knowing: application.properties defaults some of these via
# ${VAR:default}. That fallback only applies when a variable is truly UNSET -
# an exported-but-empty `VAR=` (as `source .env` produces) counts as "set to
# empty string," not unset, so the default never kicks in and Spring binds
# an empty/null value instead. Give every variable actually used locally a
# real value below rather than leaving it blank - this bit us once already
# (SESSION_TTL/SESSION_IDLE_TIMEOUT), see DECISIONS.md.

APP_DOMAIN=example.com
APP_BASE_URL=http://localhost:5173

# Local dev backend (no Docker) connects directly to a Neon Postgres branch -
# see DECISIONS.md ("Neon Postgres replaces H2 for local development") and
# backend/README.md. Use a dev/preview Neon branch, not production, where possible.
#
# Two roles, per ADR-010: DATABASE_USER is the runtime app role and must NOT
# have BYPASSRLS, or every RLS policy from Phase 2 on is silently ineffective
# for real traffic. Neon's default role (e.g. neondb_owner) has BYPASSRLS, so
# create a separate restricted role for this (see DECISIONS.md for the exact
# CREATE ROLE/GRANT statements) and use the privileged default role only for
# FLYWAY_DATABASE_USER below.
DATABASE_URL=jdbc:postgresql://your-neon-host/your-db?sslmode=require
DATABASE_USER=
DATABASE_PASSWORD=

# Migrations run under the privileged role (BYPASSRLS) - see ADR-010.
FLYWAY_DATABASE_USER=
FLYWAY_DATABASE_PASSWORD=

# Compose feeds these into the backend's DATABASE_URL/USER/PASSWORD for the
# self-hosted staging/production Postgres container (docs/08-devops/environments.md).
POSTGRES_DB=finance
POSTGRES_USER=finance
POSTGRES_PASSWORD=

STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# AI_ENABLED is the kill switch (docs/08-devops/environments.md) - flip to false to
# disable AI without a deploy. D-03 (provider/model) is still open; leave AI off until decided.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_ENABLED=false
AI_USER_DAILY_TOKEN_CAP=
AI_GLOBAL_MONTHLY_COST_CAP=

SESSION_TTL=30d
SESSION_IDLE_TIMEOUT=24h

# Resend (ADR-016).
MAIL_PROVIDER=resend
MAIL_API_KEY=
MAIL_FROM=
