# Copy to .env and fill in real values. Never commit the real .env (see .gitignore).
# Full variable reference: docs/08-devops/environments.md

APP_DOMAIN=example.com
APP_BASE_URL=https://example.com

# Local dev backend (no Docker) connects directly to a Neon Postgres branch -
# see DECISIONS.md ("Neon Postgres replaces H2 for local development") and
# backend/README.md. Use a dev/preview Neon branch, not production, where possible.
DATABASE_URL=jdbc:postgresql://your-neon-host/your-db?sslmode=require
DATABASE_USER=
DATABASE_PASSWORD=

# Compose feeds these into the backend's DATABASE_URL/USER/PASSWORD for the
# self-hosted staging/production Postgres container (docs/08-devops/environments.md).
POSTGRES_DB=finance
POSTGRES_USER=finance
POSTGRES_PASSWORD=

STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# AI_ENABLED is the kill switch (docs/08-devops/environments.md) - flip to false to
# disable AI without a deploy. D-03 (provider/model) is still open; leave AI off until decided.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_ENABLED=false
AI_USER_DAILY_TOKEN_CAP=
AI_GLOBAL_MONTHLY_COST_CAP=

SESSION_TTL=
SESSION_IDLE_TIMEOUT=

# Resend (ADR-016).
MAIL_PROVIDER=resend
MAIL_API_KEY=
MAIL_FROM=
